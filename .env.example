# Copiază acest fișier ca ".env" pentru testare locală cu `netlify dev`.
# În producție (Netlify), aceleași variabile se setează în:
# Site settings -> Environment variables.

# Parola de acces în panoul /admin.html
ADMIN_PASSWORD=schimba-parola-asta

# Cheie secretă folosită pentru semnarea sesiunii de admin (string lung, aleator).
# Generează una locală cu: openssl rand -hex 32
ADMIN_SESSION_SECRET=schimba-si-cheia-asta
